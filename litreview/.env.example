# Copy to `.env` (same dir or repo root) and fill in. Loaded via python-dotenv.

# Polite-pool contact for OpenAlex / Unpaywall (improves rate limits)
LITREVIEW_EMAIL=nataliewang1211@gmail.com

# Semantic Scholar (optional; raises rate limits). Request a key at
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Azure OpenAI — used for tier-2/3 classification and extraction
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# The model you deployed (config falls back to this for the deployment name)
AZURE_OPENAI_MODEL=gpt-4.1
# Optional: only set if your deployment name differs from the model name
# AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ESVD / TEEB valuation database export (CSV) for tier-1/2 dollar averages
ESVD_CSV=
