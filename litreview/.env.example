# Copy to `.env` (same dir or repo root) and fill in. Loaded via python-dotenv.

# Polite-pool contact for OpenAlex / Unpaywall (improves rate limits)
LITREVIEW_EMAIL=nataliewang1211@gmail.com

# Semantic Scholar (optional; raises rate limits). Request a key at
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Azure OpenAI — used for tier-2/3 classification and extraction
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# The model you deployed (config falls back to this for the deployment name)
AZURE_OPENAI_MODEL=gpt-4.1
# Optional: only set if your deployment name differs from the model name
# AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ESVD / TEEB valuation database export (CSV) for tier-1/2 dollar averages
ESVD_CSV=

# EBSCO Discovery Service (EDS) API — adds EBSCO as a count/candidate source for
# the aggregate and tier3 steps only (never keyword discovery). Needs an EDS API
# *profile* provisioned by your institution's library/EBSCO admin; logging into
# the EBSCOhost website is not the same as API access. Leave blank to skip EBSCO
# everywhere (OpenAlex-only, as before).
EBSCO_USER_ID=
EBSCO_PASSWORD=
EBSCO_PROFILE=

# Web of Science (Clarivate) API — adds WoS as a count/candidate source for the
# aggregate and tier3 steps only (never keyword discovery). Needs a WoS API key
# from your institution. Defaults to the Starter API host (metadata-only, no
# abstracts); set WOS_API_BASE if you have a different tier. Leave the key blank
# to skip WoS everywhere.
WOS_API_KEY=
# WOS_API_BASE=https://api.clarivate.com/apis/wos-starter/v1
